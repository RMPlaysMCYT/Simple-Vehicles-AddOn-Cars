{
	"type": "minecraftBedrock",
	"name": "Simple Vehicles Add-on - CARS",
	"namespace": "simvehcars",
	"authors": [
		"RMPlaysMC YT"
	],
	"targetVersion": "1.20.50",
	"description": "This Add-on adds any types of cars to your Minecraft World and It's different from the Original Ones ",
	"experimentalGameplay": {
		"creationOfCustomBiomes": false,
		"upcomingCreatorFeatures": false,
		"experimentalCreatorCameraFeatures": false,
		"enableGameTestFramework": false,
		"dataDrivenJigsawStructures": false,
		"customComponentsV2": false,
		"renderDragonFeatures": false,
		"educationEdition": false
	},
	"bdsProject": false,
	"packs": {
		"behaviorPack": "./BP",
		"resourcePack": "./RP"
	},
	"worlds": [
		"./worlds/*"
	],
	"compiler": {
		"plugins": [
			"generatorScripts",
			"typeScript",
			"entityIdentifierAlias",
			"customEntityComponents",
			"customItemComponents",
			"customBlockComponents",
			"customCommands",
			"moLang",
			"formatVersionCorrection",
			[
				"simpleRewrite",
				{
					"packName": "Simple Vehicles Add-on - CARS"
				}
			]
		]
	}
}