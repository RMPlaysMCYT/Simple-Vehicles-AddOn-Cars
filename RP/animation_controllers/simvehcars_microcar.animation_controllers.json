{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.simvehcars_microcar.move": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["idle"],
					"transitions": [
						{"walking": "q.ground_speed > 1.0"}
					],
					"blend_transition": 0.2
				},
				"walking": {
					"animations": ["move"],
					"transitions": [
						{"idle": "q.ground_speed < 0.5"}
					],
					"blend_transition": 0.2
				}
			}
		},
		"controller.animation.simvehcars_microcar.door_mechanic": {
			"states": {
				"default": {
					"animations": ["door_close_standby"],
					"transitions": [
						{"closed": "!q.is_ignited"},
						{"opened": "q.is_ignited"}
					]
				},
				"closed": {
					"animations": ["door_close"],
					"transitions": [
						{"open": "q.is_ignited"}
					]
				},
				"open": {
					"animations": ["door_open"],
					"transitions": [
						{"opened": "query.any_animation_finished"},
						{"close": "!q.is_ignited"}
					],
					"blend_transition": 0.1
				},
				"opened": {
					"transitions": [
						{"close": "!q.is_ignited"}
					],
					"blend_transition": 0.1
				},
				"close": {
					"animations": ["door_close"],
					"transitions": [
						{"closed": "query.all_animations_finished"}
					]
				}
			}
		}
	}
}